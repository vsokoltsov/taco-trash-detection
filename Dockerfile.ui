FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
COPY trash_annotation/ trash_annotation/

RUN pip install --no-cache-dir streamlit requests Pillow

EXPOSE 8501

CMD ["streamlit", "run", "trash_annotation/ui.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true"]