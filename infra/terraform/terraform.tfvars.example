project_id  = "my-gcp-project"
region      = "europe-west1"
zone        = "europe-west1-b"
environment = "prod"

name_prefix = "taco-trash"

gke_namespace            = "taco-trash"
gke_service_account_name = "taco-trash-api"
gke_node_machine_type    = "e2-standard-4"
gke_min_node_count       = 1
gke_max_node_count       = 3

# Leave empty to use "<project_id>-taco-trash-models".
model_bucket_name          = ""
model_bucket_force_destroy = true

# App Engine location cannot be changed after creation.
app_engine_location_id          = "europe-west"
create_app_engine_application   = true

github_repository    = "vsokoltsov/taco-trash-detection"
github_deploy_branches = ["main", "master"]

# Requires GITHUB_TOKEN in the environment when running Terraform.
configure_github_actions_variables = true

# Optional. Leave empty to use "http://<reserved-api-ingress-ip>".
# Prefer a custom HTTPS domain for production.
api_url = ""

cloud_run_ui_service_name = "taco-trash-ui"
